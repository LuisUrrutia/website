{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successCommentCondition": "<% return issue.pull_request; %>"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bun run build",
        "successCmd": "printf '%s\\n' 'new-release-published=true' 'new-release-version=${nextRelease.version}' 'new-release-tag=${nextRelease.gitTag}' >> \"$GITHUB_OUTPUT\""
      }
    ]
  ]
}
