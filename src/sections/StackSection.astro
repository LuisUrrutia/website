---
/**
 * StackSection - An interactive section displaying technology skills.
 *
 * Features category filtering, expand/collapse functionality, and accessibility
 * announcements for screen readers. Technologies can be filtered by category
 * and the list expands to show all items.
 *
 * @example
 * ```astro
 * <StackSection
 *   technologies={[
 *     { name: "React", icon: "/tech/react.svg", experience: 5, category: "frameworks" }
 *   ]}
 *   initialVisible={9}
 * />
 * ```
 */
import type { Technology, TechnologyCategory } from "@/types/technology";
import Card from "@/components/Card.astro";
import ClearFilterButton from "@/components/ClearFilterButton.astro";
import FilterChip from "@/components/FilterChip.astro";
import TechItem from "@/components/TechItem.astro";
import ExpandButton from "@/components/ExpandButton.astro";
import { formatExperience } from "@/lib/formatters";

interface Props {
	/** Array of technologies to display. */
	technologies: Technology[];
	/** Number of items visible before expanding. Defaults to 9. */
	initialVisible?: number;
	/** Section ID for navigation. Defaults to "stack". */
	id?: string;
}

const { technologies, initialVisible = 9, id = "stack" } = Astro.props;
const { t } = Astro.locals;

const categories: { id: TechnologyCategory; label: string }[] = [
	{ id: "frameworks", label: t("stack.frameworks") },
	{ id: "languages", label: t("stack.languages") },
	{ id: "tools", label: t("stack.tools") },
];

// Pre-compute indices by category at build time
const indicesByCategory: Record<TechnologyCategory, number[]> = {
	frameworks: [],
	languages: [],
	tools: [],
};

technologies.forEach((technology, index) => {
	indicesByCategory[technology.category].push(index);
});
---

<Card as="section" id={id} aria-labelledby={`${id}-heading`}>
	<div
		class="stack-section flex flex-col gap-6"
		data-initial-visible={initialVisible}
		data-indices={JSON.stringify(indicesByCategory)}
		data-status-template={t("stack.showing")}
	>
		<header
			class="relative flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between"
		>
			<h2 id={`${id}-heading`} class="text-title text-2xl font-semibold">
				{t("stack.title")}
			</h2>
			<div
				class="stack-filters flex w-full flex-col gap-2 min-[465px]:w-auto min-[465px]:flex-row min-[465px]:items-center"
			>
				<ClearFilterButton
					class="stack-clear absolute top-0 right-0 min-[465px]:static min-[465px]:order-last sm:order-first"
					aria-label={t("common.clearFilters")}
				/>
				{
					categories.map(({ id, label }) => (
						<FilterChip
							class="stack-filter"
							data-category={id}
							category={id}
							label={label}
						/>
					))
				}
			</div>
		</header>

		<ul
			class="stack-grid grid list-none grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3"
			role="list"
		>
			{
				technologies.map((tech, index) => (
					<li class:list={["stack-item", { hidden: index >= initialVisible }]}>
						<TechItem
							name={tech.name}
							icon={tech.icon}
							colorMode={tech.colorMode}
							experienceText={formatExperience(tech.experience, t)}
							loading={index < initialVisible ? "eager" : "lazy"}
						/>
					</li>
				))
			}
		</ul>

		<ExpandButton
			id="stack-expand-btn"
			expandedText={t("common.viewLess")}
			collapsedText={t("common.viewMore")}
			class:list={[
				"stack-expand-btn",
				{ hidden: technologies.length <= initialVisible },
			]}
		/>

		<div class="stack-status sr-only" aria-live="polite" aria-atomic="true">
		</div>
	</div>
</Card>

<script>
	import { initStackSections } from "@/sections/stack-section/stack-section";

	initStackSections();
</script>
