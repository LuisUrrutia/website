---
/**
 * HeroSection - The main introduction section of the portfolio.
 *
 * Displays profile picture, name, bio, work status, location, social links,
 * and a marquee of companies worked with.
 *
 * @example
 * ```astro
 * <HeroSection
 *   socials={{ github: "https://github.com/user", linkedin: "https://linkedin.com/in/user" }}
 *   workStatus="open"
 * />
 * ```
 */
import type { Company } from "@/types/company";
import type { SocialLinksProps } from "@/types/social";
import IconArrowRight from "@/assets/icons/arrow-right.svg";
import Card from "@/components/Card.astro";
import CompanyMarquee from "@/components/CompanyMarquee.astro";
import IconLocation from "@/assets/icons/location.svg";
import IconRocket from "@/assets/icons/rocket.svg";
import ProfilePicture from "@/components/ProfilePicture.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import WorkStatusBadge from "@/components/WorkStatusBadge.astro";
import { companies as defaultCompanies } from "@/data/companies";
import { getLinkPolicy } from "@/lib/link-policy";

type WorkStatus = "open" | "busy";

interface Props {
	/** Social media links configuration. */
	socials?: SocialLinksProps;
	/** Current work availability status. Defaults to "busy". */
	workStatus?: WorkStatus;
	/** List of companies to display in the marquee. */
	companies?: Company[];
	/** Section ID for navigation. Defaults to "hero". */
	id?: string;
	/** Optional direct contact link displayed alongside the location. */
	contactHref?: string;
}

const {
	socials,
	workStatus = "busy",
	companies = defaultCompanies,
	id = "hero",
	contactHref,
} = Astro.props;
const { t } = Astro.locals;
const openZeppelinLinkPolicy = getLinkPolicy("https://www.openzeppelin.com/");

const statusTextKey = workStatus === "open" ? "status.open" : "status.busy";
const statusDescriptionKey =
	workStatus === "open" ? "status.open.description" : "status.busy.description";
---

<Card
	as="section"
	id={id}
	aria-labelledby={`${id}-heading`}
	class="flex flex-col gap-5"
>
	<div class="flex flex-col gap-4 lg:flex-row">
		<ProfilePicture alt={t("hero.photoAlt")} />

		<div class="flex flex-1 flex-col gap-4">
			<div class="flex flex-row justify-between gap-5 py-2 lg:py-0">
				<WorkStatusBadge
					status={workStatus}
					statusText={t(statusTextKey)}
					description={t(statusDescriptionKey)}
				/>
				<div class="flex items-center gap-3">
					{
						socials && (
							<SocialLinks
								ariaLabel={t("a11y.socialLinksHeader")}
								{...socials}
							/>
						)
					}
				</div>
			</div>

			<div class="flex flex-col gap-2.5 py-2.5">
				<div>
					<h1 id={`${id}-heading`} class="text-title text-4xl font-semibold">
						{t("hero.greeting")}
						<span class="block sm:inline">{t("hero.intro")}</span>
					</h1>
					<p class="text-muted my-1 text-sm font-light text-pretty">
						{t("hero.tagline.prefix")}<a
							href="https://www.openzeppelin.com/"
							{...openZeppelinLinkPolicy.newTabAttributes}
							class="text-accent font-medium underline-offset-2 hover:underline"
							>OpenZeppelin</a
						> · {t("hero.tagline.tech")}
					</p>
				</div>
				<p class="relative text-base font-light text-pretty">
					<strong
						class="highlight highlight--sky text-title relative z-0 inline-block font-semibold whitespace-nowrap"
						>{t("hero.bio.role")}</strong
					>{t("hero.bio.middle")}<strong
						class="highlight highlight--orange text-title relative z-0 inline-block font-semibold whitespace-nowrap"
						>{t("hero.bio.experience")}</strong
					>{t("hero.bio.suffix")}
				</p>
			</div>

			<div class="flex flex-wrap items-center justify-between gap-3">
				<div class="flex items-center gap-2.5 text-sm font-light">
					<IconLocation class="size-4" aria-hidden="true" />
					<span>{t("hero.location")}</span>
				</div>
				{
					contactHref && (
						<a
							href={contactHref}
							aria-label={`${t("contact.cta")} - ${t("a11y.opensEmailClient")}`}
							class="group text-accent focus-visible:ring-accent focus-visible:ring-offset-card inline-flex min-h-11 items-center gap-1.5 rounded-lg px-1 text-sm font-medium underline-offset-4 transition-colors hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 sm:min-h-0 sm:translate-y-px"
						>
							<span>{t("contact.cta")}</span>
							<IconArrowRight
								class="size-4 transition-transform group-hover:translate-x-1 motion-reduce:transition-none"
								aria-hidden="true"
							/>
						</a>
					)
				}
			</div>
		</div>
	</div>

	<div class="flex flex-col gap-3">
		<p class="flex items-center gap-1.5 text-sm font-light">
			<IconRocket />
			{t("hero.companies")}
		</p>
		<CompanyMarquee companies={companies} label={t("hero.companies")} />
	</div>
</Card>

<style>
	.highlight::before {
		content: "";
		position: absolute;
		inset: -0.375rem -0.25rem;
		z-index: -1;
		background-color: var(--highlight-color);
		mask-image: url("/images/brush-1.svg");
		mask-size: 100% 100%;
		clip-path: inset(0 100% 0 0);
		rotate: var(--highlight-rotation);
		animation: draw-in 0.6s ease-out forwards;
		animation-delay: var(--highlight-delay, 0s);
	}

	.highlight--sky {
		--highlight-color: var(--color-highlight-sky);
		--highlight-rotation: -3deg;
		--highlight-delay: 0.2s;
	}

	.highlight--orange {
		--highlight-color: var(--color-highlight-orange);
		--highlight-rotation: 3deg;
		--highlight-delay: 0.4s;
	}

	@keyframes draw-in {
		from {
			clip-path: inset(0 100% 0 0);
		}
		to {
			clip-path: inset(0 0 0 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.highlight::before {
			animation: none;
			clip-path: none;
		}
	}
</style>
