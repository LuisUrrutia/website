---
import type { Company } from "@/types/company";
import IconGitCommit from "@/assets/icons/git-commit.svg";
import { getNewTabLinkAttributes } from "@/lib/link-policy";

type Direction = "left" | "right";

interface Props {
	companies: Company[];
	label: string;
	duration?: number;
	direction?: Direction;
}

const { companies, label, duration = 45, direction = "left" } = Astro.props;
const { t } = Astro.locals;
const newTabAttributes = getNewTabLinkAttributes();
---

<div class="company-marquee flex flex-col gap-2">
	<div class="marquee-container" style={`--marquee-duration: ${duration}s`}>
		<!-- Keyboard focus reveals the complete, stationary company list. -->
		<ul class="company-list sr-only" aria-label={label}>
			{
				companies.map((company) => (
					<li>
						<a
							href={company.url}
							{...newTabAttributes}
							class="text-accent focus-visible:ring-accent inline-flex min-h-11 items-center rounded-sm px-2 underline underline-offset-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
						>
							{company.name}
							<span class="sr-only">{t("a11y.opensInNewTab")}</span>
						</a>
					</li>
				))
			}
		</ul>

		<!-- Visual marquee (hidden from screen readers) -->
		<div
			class:list={[
				"marquee-track",
				{ "marquee-track--reverse": direction === "right" },
			]}
			aria-hidden="true"
		>
			{
				[0, 1].map((iteration) => (
					<div class="marquee-content">
						{companies.map((company, index) => (
							<>
								{index > 0 && <IconGitCommit class="marquee-separator" />}
								<a
									href={company.url}
									{...newTabAttributes}
									tabindex="-1"
									class="marquee-link"
								>
									<img
										src={company.logo}
										alt={`${company.name} logo`}
										class="marquee-logo marquee-logo--light"
										width={company.width}
										height="28"
										loading={iteration === 0 ? "eager" : "lazy"}
										decoding="async"
									/>
									<img
										src={company.logoDark}
										alt=""
										class="marquee-logo marquee-logo--dark"
										width={company.width}
										height="28"
										loading="lazy"
										decoding="async"
									/>
								</a>
							</>
						))}
						<IconGitCommit class="marquee-separator" />
					</div>
				))
			}
		</div>
	</div>
	<button
		type="button"
		aria-pressed="false"
		class="marquee-pause text-subtitle focus-visible:ring-accent min-h-11 cursor-pointer self-end rounded-lg px-3 text-sm underline underline-offset-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
		aria-label={t("a11y.pauseCompanyAnimation")}
	>
		{t("hero.pauseAnimation")}
	</button>
</div>

<style>
	.marquee-container {
		position: relative;
		overflow: hidden;
		touch-action: pan-y;
		-webkit-mask-image: linear-gradient(
			to right,
			transparent,
			black 5%,
			black 95%,
			transparent
		);
		mask-image: linear-gradient(
			to right,
			transparent,
			black 5%,
			black 95%,
			transparent
		);
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee var(--marquee-duration) linear infinite;
		transform: translateZ(0);
		user-select: none;
		will-change: transform;
	}

	.marquee-track--reverse {
		animation-direction: reverse;
	}

	.marquee-container:hover .marquee-track {
		animation-play-state: paused;
	}

	.company-marquee:has(.marquee-pause[aria-pressed="true"]) .marquee-track,
	.marquee-container:has(.company-list:focus-within) .marquee-track {
		animation-play-state: paused;
	}

	.marquee-container:has(.company-list:focus-within) {
		mask-image: none;
		-webkit-mask-image: none;
		overflow: visible;
	}

	.company-list:focus-within {
		position: static;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		width: auto;
		height: auto;
		margin: 0;
		overflow: visible;
		clip-path: none;
		white-space: normal;
	}

	.marquee-container:has(.company-list:focus-within) .marquee-track {
		display: none;
	}

	.marquee-pause[aria-pressed="true"] {
		background: var(--color-pill);
		color: var(--color-pill-foreground);
	}

	.marquee-content {
		display: flex;
		align-items: center;
		gap: 2rem;
		padding-right: 2rem;
	}

	.marquee-link {
		display: block;
		opacity: 0.7;
		transition: opacity 0.2s ease;
	}

	.marquee-link:hover {
		opacity: 1;
	}

	.marquee-logo {
		height: 1.75rem;
		width: auto;
	}

	.marquee-logo--light {
		display: block;
	}

	.marquee-logo--dark {
		display: none;
	}

	:global([data-theme="dark"]) .marquee-logo--light {
		display: none;
	}

	:global([data-theme="dark"]) .marquee-logo--dark {
		display: block;
	}

	.marquee-separator {
		color: var(--color-subtitle);
		flex-shrink: 0;
		opacity: 0.55;
	}

	@keyframes marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	.marquee-track.is-dragging {
		animation: none;
		cursor: grabbing;
	}

	@media (prefers-reduced-motion: reduce), (scripting: none) {
		.marquee-track {
			animation: none;
			display: none;
		}
		.marquee-container {
			mask-image: none;
			-webkit-mask-image: none;
			overflow: visible;
		}
		.company-list {
			position: static;
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem 1rem;
			width: auto;
			height: auto;
			margin: 0;
			overflow: visible;
			clip-path: none;
			white-space: normal;
		}
		.marquee-pause {
			display: none;
		}
	}
</style>

<script>
	interface MotionSample {
		x: number;
		time: number;
	}

	const SAMPLE_WINDOW_MS = 80;
	const PROJECTION_MS = 180;
	const INERTIA_DURATION_MS = 220;
	const REDUCED_INERTIA_DURATION_MS = 100;
	const MAX_INERTIA_VIEWPORT_RATIO = 0.25;
	const REDUCED_MAX_INERTIA_VIEWPORT_RATIO = 0.04;
	const DRAG_THRESHOLD_PX = 5;

	function clamp(value: number, minimum: number, maximum: number): number {
		return Math.min(Math.max(value, minimum), maximum);
	}

	function normalizeOffset(offset: number, contentWidth: number): number {
		const normalized = offset % contentWidth;
		return normalized > 0 ? normalized - contentWidth : normalized;
	}

	function initMarqueeDrag(): void {
		document
			.querySelectorAll<HTMLElement>(".marquee-container")
			.forEach((container) => {
				if (container.dataset.dragInit) return;
				container.dataset.dragInit = "true";

				const trackElement =
					container.querySelector<HTMLElement>(".marquee-track");
				if (!trackElement) return;
				const track: HTMLElement = trackElement;
				const pauseButton =
					container.parentElement?.querySelector<HTMLButtonElement>(
						".marquee-pause",
					);
				pauseButton?.addEventListener("click", () => {
					const offset = getTranslateX();
					inertiaAnimation?.cancel();
					inertiaAnimation = undefined;
					delete track.dataset.inertiaActive;
					resumeMarquee(offset, track.scrollWidth / 2);
					pauseButton.setAttribute(
						"aria-pressed",
						String(pauseButton.getAttribute("aria-pressed") !== "true"),
					);
				});

				const isReverse = track.classList.contains("marquee-track--reverse");
				let isDragging = false;
				let activePointerId: number | undefined;
				let startX = 0;
				let currentOffset = 0;
				let dragDistance = 0;
				let suppressNextClick = false;
				let samples: MotionSample[] = [];
				let inertiaAnimation: Animation | undefined;

				function getTranslateX(): number {
					const matrix = new DOMMatrix(getComputedStyle(track).transform);
					return matrix.m41;
				}

				function recordSample(x: number): void {
					const time = performance.now();
					samples = samples.filter(
						(sample) => time - sample.time <= SAMPLE_WINDOW_MS,
					);
					samples.push({ x, time });
				}

				function getVelocity(): number {
					const first = samples[0];
					const last = samples[samples.length - 1];
					if (!first || !last || first === last) return 0;

					const elapsed = last.time - first.time;
					return elapsed > 0 ? (last.x - first.x) / elapsed : 0;
				}

				function onStart(x: number): void {
					isDragging = true;
					startX = x;
					currentOffset = getTranslateX();
					inertiaAnimation?.cancel();
					inertiaAnimation = undefined;
					delete track.dataset.inertiaActive;
					track.classList.add("is-dragging");
					track.style.transform = `translateX(${currentOffset}px)`;
					dragDistance = 0;
					samples = [];
					recordSample(x);
				}

				function onMove(x: number): void {
					if (!isDragging) return;
					const delta = x - startX;
					dragDistance = Math.max(dragDistance, Math.abs(delta));
					const contentWidth = track.scrollWidth / 2;
					let newOffset = currentOffset + delta;

					if (newOffset > 0) newOffset -= contentWidth;
					if (newOffset < -contentWidth) newOffset += contentWidth;

					track.style.transform = `translateX(${newOffset}px)`;
					recordSample(x);
				}

				function resumeMarquee(offset: number, contentWidth: number): void {
					const normalizedOffset = normalizeOffset(offset, contentWidth);
					const prefersReducedMotion = window.matchMedia(
						"(prefers-reduced-motion: reduce)",
					).matches;

					if (prefersReducedMotion) {
						track.style.transform = `translateX(${normalizedOffset}px)`;
						track.classList.remove("is-dragging");
						return;
					}

					let progress = -normalizedOffset / contentWidth;
					if (isReverse) progress = 1 - progress;
					progress = ((progress % 1) + 1) % 1;
					const duration = Number.parseFloat(
						getComputedStyle(container).getPropertyValue("--marquee-duration"),
					);
					track.style.animationDelay = `-${progress * duration}s`;
					track.style.transform = "";
					track.classList.remove("is-dragging");
				}

				function onEnd(x: number): void {
					if (!isDragging) return;
					recordSample(x);
					isDragging = false;
					suppressNextClick = dragDistance >= DRAG_THRESHOLD_PX;

					const contentWidth = track.scrollWidth / 2;
					const finalX = getTranslateX();
					const prefersReducedMotion = window.matchMedia(
						"(prefers-reduced-motion: reduce)",
					).matches;
					const maximumProjection =
						window.innerWidth *
						(prefersReducedMotion
							? REDUCED_MAX_INERTIA_VIEWPORT_RATIO
							: MAX_INERTIA_VIEWPORT_RATIO);
					const projection = clamp(
						getVelocity() * PROJECTION_MS,
						-maximumProjection,
						maximumProjection,
					);
					let animationStart = finalX;
					let animationEnd = finalX + projection;

					if (animationEnd > 0) {
						animationStart -= contentWidth;
						animationEnd -= contentWidth;
					} else if (animationEnd < -contentWidth) {
						animationStart += contentWidth;
						animationEnd += contentWidth;
					}

					track.style.transform = `translateX(${animationStart}px)`;
					const easing = getComputedStyle(document.documentElement)
						.getPropertyValue("--ease-out")
						.trim();
					const animation = track.animate(
						[
							{ transform: `translateX(${animationStart}px)` },
							{ transform: `translateX(${animationEnd}px)` },
						],
						{
							duration: prefersReducedMotion
								? REDUCED_INERTIA_DURATION_MS
								: INERTIA_DURATION_MS,
							easing,
							fill: "forwards",
						},
					);
					inertiaAnimation = animation;
					track.dataset.inertiaActive = "true";

					void animation.finished
						.then(() => {
							if (inertiaAnimation !== animation || isDragging) return;
							inertiaAnimation = undefined;
							delete track.dataset.inertiaActive;
							track.style.transform = `translateX(${animationEnd}px)`;
							animation.cancel();
							resumeMarquee(animationEnd, contentWidth);
						})
						.catch(() => undefined);
				}

				container.addEventListener("pointerdown", (event) => {
					if (
						event.target instanceof Element &&
						event.target.closest(".company-list")
					)
						return;
					if (activePointerId !== undefined) return;
					activePointerId = event.pointerId;
					container.setPointerCapture(event.pointerId);
					onStart(event.clientX);
				});

				container.addEventListener("pointermove", (event) => {
					if (event.pointerId !== activePointerId) return;
					onMove(event.clientX);
				});

				function finishPointer(event: PointerEvent): void {
					if (event.pointerId !== activePointerId) return;
					onEnd(event.clientX);
					if (container.hasPointerCapture(event.pointerId)) {
						container.releasePointerCapture(event.pointerId);
					}
					activePointerId = undefined;
				}

				container.addEventListener("pointerup", finishPointer);
				container.addEventListener("pointercancel", finishPointer);
				container.addEventListener(
					"click",
					(event) => {
						if (!suppressNextClick) return;
						suppressNextClick = false;
						event.preventDefault();
						event.stopPropagation();
					},
					true,
				);
			});
	}

	initMarqueeDrag();
</script>
