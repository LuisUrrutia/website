---
interface Props {
	kind: "repository" | "worktree";
	class?: string;
}

const { kind, class: className } = Astro.props;
---

{
	kind === "repository" ? (
		<svg
			class:list={["folder-glyph", className]}
			viewBox="212 0 72 61"
			fill="none"
			aria-hidden="true"
		>
			<path d="M276 59.6C277.857 59.6 279.637 58.8687 280.95 57.567C282.263 56.2653 283 54.4997 283 52.6588V17.9529C283 16.112 282.263 14.3465 280.95 13.0448C279.637 11.7431 277.857 11.0118 276 11.0118H248.35C247.179 11.0231 246.024 10.7432 244.991 10.1975C243.958 9.65181 243.079 8.85783 242.435 7.88824L239.6 3.72353C238.963 2.76381 238.095 1.97602 237.075 1.43085C236.055 0.885678 234.914 0.60019 233.755 0.6H220C218.143 0.6 216.363 1.3313 215.05 2.63302C213.737 3.93475 213 5.70026 213 7.54118V52.6588C213 54.4997 213.737 56.2653 215.05 57.567C216.363 58.8687 218.143 59.6 220 59.6H276Z" />
			<text x="248" y="37" text-anchor="middle">
				.git
			</text>
		</svg>
	) : (
		<svg
			class:list={["folder-glyph", className]}
			viewBox="54 77 73 60"
			fill="none"
			aria-hidden="true"
		>
			<path d="M69.7976 115.482L74.9717 105.759C75.5342 104.673 76.3898 103.756 77.447 103.107C78.5042 102.457 79.7232 102.099 80.9736 102.071H118.089M118.089 102.071C119.143 102.069 120.183 102.302 121.13 102.752C122.077 103.201 122.905 103.856 123.551 104.665C124.198 105.475 124.644 106.417 124.857 107.42C125.071 108.424 125.044 109.461 124.781 110.453L119.469 130.57C119.085 132.017 118.214 133.298 116.995 134.209C115.777 135.121 114.28 135.61 112.743 135.6H62.8988C61.0691 135.6 59.3144 134.893 58.0206 133.636C56.7268 132.378 56 130.673 56 128.894V85.3061C56 83.5277 56.7268 81.822 58.0206 80.5644C59.3144 79.3068 61.0691 78.6003 62.8988 78.6003H76.3514C77.5052 78.5893 78.6434 78.8598 79.6618 79.387C80.6802 79.9142 81.5464 80.6812 82.1809 81.6179L84.9749 85.6414C85.6031 86.5686 86.4582 87.3297 87.4637 87.8564C88.4691 88.3831 89.5933 88.6589 90.7354 88.6591H111.19C113.02 88.6591 114.775 89.3656 116.068 90.6232C117.362 91.8807 118.089 93.5864 118.089 95.3649V102.071Z" />
		</svg>
	)
}

<style>
	.folder-glyph {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}

	path {
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.7;
	}

	text {
		fill: currentColor;
		font-family: var(--font-sans);
		font-size: 13px;
		font-weight: 500;
	}
</style>
