---
/**
 * LocaleScript - Inline blocking script for locale detection and redirect.
 *
 * Handles:
 * - Browser language detection for first-time visitors only
 * - Automatic redirect to preferred locale on first visit
 *
 * The redirect target comes from the page's own `hreflang` link tags, which is
 * the only source that knows the translated slug of a blog post. Pages that
 * have no translation for the browser locale fall back to that locale's home.
 *
 * After the first visit, users can navigate freely between locales.
 * Must be placed in <head> after the SEO tags and before any rendering.
 */
import { getLocalizedPath, locales } from "@/i18n";

interface Props {
	currentLocale: string;
}

const { currentLocale } = Astro.props;
const homeUrls = Object.fromEntries(
	locales.map((locale) => [locale, getLocalizedPath("/", locale)]),
);
---

<script
	is:inline
	data-current-locale={currentLocale}
	data-home-urls={JSON.stringify(homeUrls)}
>
	(function () {
		const script = document.currentScript;
		const currentLocale = script.dataset.currentLocale;
		const homeUrls = JSON.parse(script.dataset.homeUrls);

		const HAS_VISITED_KEY = "has-visited";
		const COOKIE_NAME = "has-visited";

		function getCookie(name) {
			const cookies = document.cookie.split(";");
			for (let i = 0; i < cookies.length; i++) {
				const cookie = cookies[i].trim();
				if (cookie.startsWith(name + "=")) {
					return cookie.substring(name.length + 1);
				}
			}
			return null;
		}

		function setCookie(name, value, maxAge) {
			var secure = window.location.protocol === "https:" ? ";Secure" : "";
			document.cookie =
				name +
				"=" +
				value +
				";path=/;max-age=" +
				maxAge +
				";SameSite=Lax" +
				secure;
		}

		function hasVisited() {
			try {
				return localStorage.getItem(HAS_VISITED_KEY) === "true";
			} catch {
				return getCookie(COOKIE_NAME) === "true";
			}
		}

		function setHasVisited() {
			const maxAge = 60 * 60 * 24 * 365; // 1 year
			try {
				localStorage.setItem(HAS_VISITED_KEY, "true");
			} catch {
				// localStorage not available
			}
			setCookie(COOKIE_NAME, "true", maxAge);
		}

		function getBrowserLocale() {
			const browserLang = navigator.language;
			if (!browserLang) return null;

			// Match the language only (e.g., "es-CL" -> "es")
			const langCode = browserLang.split("-")[0].toLowerCase();
			return Object.hasOwn(homeUrls, langCode) ? langCode : null;
		}

		function getAlternateUrl(locale) {
			const link = document.querySelector(
				'link[rel="alternate"][hreflang="' + locale + '"]:not([type])',
			);
			return link ? link.href : homeUrls[locale];
		}

		// Only redirect on first visit
		if (hasVisited()) {
			return;
		}

		// Mark as visited
		setHasVisited();

		// Detect browser language and redirect if needed
		const browserLocale = getBrowserLocale();
		if (browserLocale && browserLocale !== currentLocale) {
			const target = new URL(getAlternateUrl(browserLocale), window.location);
			target.search = window.location.search;
			window.location.replace(target.href);
		}
	})();
</script>
