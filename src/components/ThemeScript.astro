---
// Inline blocking script to prevent theme flash
// Native MPA navigation reloads this script before every page render.
import { THEME_KEY } from "@/lib/theme/constants";
---

<script is:inline data-theme-key={THEME_KEY}>
	function applyTheme() {
		const key = document.currentScript.dataset.themeKey;
		let stored;
		try {
			stored = localStorage.getItem(key);
		} catch {
			// Storage can be blocked even when the browser supports localStorage.
		}
		const prefersDark = window.matchMedia(
			"(prefers-color-scheme: dark)",
		).matches;

		let theme;
		let mode;
		if (stored === "light" || stored === "dark") {
			theme = stored;
			mode = stored;
		} else {
			theme = prefersDark ? "dark" : "light";
			mode = "auto";
		}

		document.documentElement.dataset.theme = theme;
		document.documentElement.dataset.themeMode = mode;
	}

	applyTheme();
</script>
