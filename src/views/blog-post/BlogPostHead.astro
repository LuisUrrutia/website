---
import { ArticleJsonLd, BreadcrumbJsonLd } from "@/components/seo";
import type {
	BlogPostLike,
	BlogPostPageMetadata,
} from "@/views/blog-post/blog-post-metadata";
import type { Locale } from "@/i18n";

interface Props {
	post: BlogPostLike;
	metadata: BlogPostPageMetadata;
	lang: Locale;
}

const { post, metadata, lang } = Astro.props;
---

<!-- Giscus comments load only on posts, so warm its origin here -->
<link rel="preconnect" href="https://giscus.app" crossorigin />
<link rel="dns-prefetch" href="https://giscus.app" />
<BreadcrumbJsonLd items={metadata.breadcrumbItems} />
<ArticleJsonLd
	title={post.data.title}
	description={post.data.description}
	url={metadata.postUrl}
	siteUrl={metadata.siteUrl}
	image={metadata.absoluteOgImage}
	publishedTime={post.data.date}
	modifiedTime={post.data.updatedDate}
	tags={post.data.tags}
	lang={lang}
/>
