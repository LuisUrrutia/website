---
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Container from "@/components/Container.astro";
import { siteOwner } from "@/data/seo";
import { getSiteUrl } from "@/i18n";
import BlogPostArticle from "@/views/blog-post/BlogPostArticle.astro";
import BlogPostContent from "@/views/blog-post/BlogPostContent.astro";
import BlogPostHead from "@/views/blog-post/BlogPostHead.astro";
import BlogPostProseStyles from "@/views/blog-post/BlogPostProseStyles.astro";
import { prepareBlogPostPageMetadata } from "@/views/blog-post/blog-post-metadata";

interface Props {
	post: CollectionEntry<"blog">;
	translatedPost?: CollectionEntry<"blog">;
}

const { post, translatedPost } = Astro.props;
const { t, lang } = Astro.locals;

const siteUrl = getSiteUrl({ site: Astro.site, origin: Astro.url.origin });
const metadata = prepareBlogPostPageMetadata({
	post,
	translatedPost,
	lang,
	t,
	siteUrl,
});
---

<Layout
	title={post.data.title}
	description={post.data.description}
	ogImage={metadata.ogImage}
	ogType="article"
	alternateUrls={metadata.alternateUrls}
	article={{
		publishedTime: post.data.date.toISOString(),
		modifiedTime: post.data.updatedDate?.toISOString(),
		author: siteOwner.name,
		section: post.data.category,
		tags: post.data.tags,
	}}
>
	<BlogPostHead slot="head" post={post} metadata={metadata} lang={lang} />
	<Navbar />
	<Container
		as="main"
		id="main-content"
		class="flex flex-col gap-8"
		data-page-transition="slide"
	>
		<BlogPostArticle post={post} metadata={metadata} lang={lang} t={t}>
			<BlogPostContent post={post} />
		</BlogPostArticle>
	</Container>
</Layout>

<BlogPostProseStyles />
