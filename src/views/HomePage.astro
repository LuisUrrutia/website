---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import { HomePageJsonLd } from "@/components/seo";
import { getBlogPostPath, getBlogPosts } from "@/data/blog";
import { siteOwner } from "@/data/seo";
import { socials } from "@/data/socials";
import { technologies } from "@/data/technologies";
import { testimonials } from "@/data/testimonials";
import Container from "@/components/Container.astro";
import HeroSection from "@/sections/HeroSection.astro";
import StackSection from "@/sections/StackSection.astro";
import LatestPostsSection from "@/sections/LatestPostsSection.astro";
import TestimonialsSection from "@/sections/TestimonialsSection.astro";
import ContactSection from "@/sections/ContactSection.astro";
import { getLocalizedPath, getSiteUrl, getSlugWithoutLocale } from "@/i18n";

const STACK_INITIAL_VISIBLE = 6;
const LATEST_POSTS_COUNT = 3;

const { t, lang } = Astro.locals;

const siteUrl = getSiteUrl({ site: Astro.site, origin: Astro.url.origin });
const description = t("meta.description");
const contactHref = `mailto:${siteOwner.email}`;

const posts = (await getBlogPosts(lang))
	.slice(0, LATEST_POSTS_COUNT)
	.map((post) => ({
		title: post.data.title,
		category: post.data.category,
		date: post.data.date,
		href: getBlogPostPath(post, lang),
		slug: getSlugWithoutLocale(post.id),
	}));

// Icons behind "View more" are fetched ahead of the click so expanding is instant.
const hiddenTechIcons = technologies
	.slice(STACK_INITIAL_VISIBLE)
	.flatMap(({ icon }) =>
		typeof icon === "string" ? [icon] : [icon.light, icon.dark],
	);
---

<Layout ogImageAlt={t("meta.ogImageAlt")}>
	<Fragment slot="head">
		<HomePageJsonLd
			siteUrl={siteUrl}
			jobTitle={t("meta.jobTitle")}
			description={description}
		/>
		{
			hiddenTechIcons.map((href) => (
				<link rel="prefetch" href={href} as="image" />
			))
		}
	</Fragment>
	<Navbar />
	<Container
		as="main"
		id="main-content"
		class="flex flex-col gap-8"
		data-page-transition="fade"
	>
		<HeroSection
			socials={socials}
			workStatus="open"
			contactHref={contactHref}
		/>
		<StackSection
			technologies={technologies}
			initialVisible={STACK_INITIAL_VISIBLE}
		/>
		{
			posts.length > 0 && (
				<LatestPostsSection
					posts={posts}
					viewMoreHref={getLocalizedPath("/blog", lang)}
				/>
			)
		}
		<TestimonialsSection testimonials={testimonials} />
		<ContactSection contactHref={contactHref} socials={socials} />
	</Container>
</Layout>
