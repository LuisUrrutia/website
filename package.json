{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "build:preview": "rm -rf dist; astro build && astro preview",
    "check": "astro check",
    "dev": "astro dev",
    "fmt": "prettier . --check",
    "fmt:fix": "prettier . --write",
    "lint": "oxlint --type-aware",
    "prepare": "husky",
    "preview": "astro preview",
    "test": "vitest run"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "*.{js,ts,jsx,tsx,astro}": "oxlint --type-aware"
  },
  "overrides": {
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@playform/compress": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.1.6",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.41.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@prettier/plugin-oxc": "0.2.2",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "astro-compressor": "^1.3.0",
    "badge-maker": "6.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "25.0.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22.12.0"
  },
  "x-securityOverrideNotes": {
    "yaml": "Force a patched yaml version because yaml-language-server still pins 2.7.1"
  }
}
